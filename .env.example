# Personal Access Token from https://app.asana.com/0/my-apps (or Asana developer console).
# Either name works. Never commit the real value.
ASANA_PAT=
# ASANA_TOKEN=

# Shared HMAC secret for Approve / Decline / Other. Generate a long random string, e.g.:
#   openssl rand -hex 32
# Same value must be in Vercel env and in the shell that runs `npm run mint`.
APPROVAL_SECRET=

# Optional. Used by the mint script when printing signed URLs.
# Example: https://km-command-board.vercel.app/api/decide
DECIDE_API_BASE=
