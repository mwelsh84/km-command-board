# Server-side only. Copy to `.env` for local `npm run dev`.
# Never commit real values.
#
# Do not use a NEXT_PUBLIC_ prefix (or any VITE_/PUBLIC_ prefix) for these
# variables. Nothing in this file belongs in a browser bundle.

# Personal Access Token from https://app.asana.com/0/my-apps (or Asana developer console).
# Either name works. Used only by the Vercel /api/decide function.
ASANA_PAT=
# ASANA_TOKEN=

# Authorized KM Command Center workflow. /api/decide rejects tasks outside these GIDs.
ASANA_COMMAND_CENTER_PROJECT_GID=1215460449693075
ASANA_NEEDS_DECISION_SECTION_GID=1215460449693077
